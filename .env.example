# Copy this file to .env and set local environment variables.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database backend: sqlite or postgresql
DB_ENGINE=sqlite

# PostgreSQL connection settings
DB_NAME=device_inventory
DB_USER=django_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432